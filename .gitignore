# Artifact cache — content-addressed, regenerable, large
data/cache/
data/runs/
# Experiment store — append-only Parquet, regenerable from the campaign
data/experiments/
# Rendered frames and GIFs from scripts/render_step.py. Regenerable, and large.
data/renders/
# Geometry figures from scripts/plot_geometry.py. Regenerable in seconds from the numpy
# centreline layer alone — no CAD kernel, no solver — so committing them would only mean a
# set that quietly disagrees with the bounds it claims to draw.
data/figures/
*.duckdb
*.parquet

# FreeCAD working files — the source of truth for the robot model lives in the user's
# CAD; the repo carries only the exported STL/STEP below. The .FCStd is 63 MB.
configs/freecad/
*.FCStd
*.FCBak

# Generated geometry and simulation assets
*.stl
*.step
*.stp
*.3mf
*.gcode
*.xml.generated

# FEA artifacts
*.frd
*.dat
*.cvg
*.sta
*.12d
*.inp.generated

# Rendered media
*.mp4
*.gif

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Hydra
outputs/
multirun/
.hydra/

# OS / editor
.DS_Store
.vscode/
.idea/
data/explore/
data/explore_*/

# NOT generated: the measured robot's exported model files. The sim draws the simplified
# shell by default, the platform numbers were mined from the detailed one, and three tests
# validate against them (they skip, silently, when these are missing -- which is the trap).
!configs/pipebot_detailed.stl
!configs/pipebot_simplified.stl
!configs/pipebot_simplified.step
